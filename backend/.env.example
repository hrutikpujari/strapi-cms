HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# For production: DATABASE_CLIENT=postgres and set DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD or DATABASE_URL

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# On-demand ISR revalidation (Strapi lifecycle hooks POST here)
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=generate-a-random-hex-string

# Media storage — leave blank in dev (local /uploads); set all three in production
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Provision/reset a super-admin on boot (set in production to recover access)
ADMIN_EMAIL=
ADMIN_PASSWORD=
