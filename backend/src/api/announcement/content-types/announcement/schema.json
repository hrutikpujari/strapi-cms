{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": {
    "singularName": "announcement",
    "pluralName": "announcements",
    "displayName": "Announcement",
    "description": "Company news and notices shown on the site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "body": {
      "type": "blocks",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["Company", "Product", "Press", "Event", "Careers"],
      "default": "Company"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "publishDate": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "date"
    },
    "linkUrl": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string",
      "maxLength": 70
    },
    "seoDescription": {
      "type": "text",
      "maxLength": 160
    }
  }
}
