{
  "kind": "collectionType",
  "collectionName": "awards",
  "info": {
    "singularName": "award",
    "pluralName": "awards",
    "displayName": "Award",
    "description": "Recognitions, honors, and press mentions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "issuer": {
      "type": "string",
      "required": true
    },
    "year": {
      "type": "integer",
      "required": true,
      "min": 1990,
      "max": 2100
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "badgeImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "linkUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
